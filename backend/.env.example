# Server
PORT=4000
JWT_SECRET=change_this_to_a_long_random_secret
ADMIN_SETUP_KEY=change_this_admin_bootstrap_key

# Optional: Twilio credentials (add your own real keys in .env, never in repo)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_NUMBER=+1234567890

# Optional: Fast2SMS API Key for Indian SMS (+91)
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# Optional: Google Maps API Key for server-side geocoding & directions
GOOGLE_MAPS_API_KEY=your_google_maps_key_here

# Local emergency numbers used for one-tap dial (defaults are for India)
EMERGENCY_POLICE_NUMBER=100
EMERGENCY_AMBULANCE_NUMBER=108
EMERGENCY_WOMEN_HELPLINE=1091
